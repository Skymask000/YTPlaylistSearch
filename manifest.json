{
  "manifest_version": 3,
  "name": "YT Playlist Search",
  "version": "0.1.0",
  "description": "Search across your YouTube playlists (or any public playlist by URL) and play matches with one click.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "YT Playlist Search"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["identity", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "REPLACE_WITH_OAUTH_CLIENT_ID",
    "scopes": ["https://www.googleapis.com/auth/youtube"]
  }
}
